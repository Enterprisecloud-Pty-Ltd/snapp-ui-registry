  "causes": [
    {
      "id": "TEXT-WIDTH-01",
      "status": "verified",
      "cause": "The source HUG text frames use whole CSS-pixel slots while browser intrinsic text widths remain fractional.",
      "correction": "HugText ceilings each natural label slot before surrounding padding/gaps are laid out. It preserves the natural glyph positions and source text origin; rounding a whole centered control can move those positions.",
      "owner": "registry/radix-nova/ui/hug-text.tsx",
      "nativeCss": "inline-size: calc-size(max-content, round(up, size, 1px))",
      "fallback": "When native intrinsic rounding is unavailable, measure the untransformed natural inner text using the owning view and ResizeObserver, and ceil its inline size. Adjacent text through transparent fragments remains one label.",
      "contractLimit": "Observed source behavior for these controls; Figma textAutoResize documentation does not specify a universal pixel-ceiling algorithm."
    },
    {
      "id": "TEXT-WIDTH-02",
      "status": "verified-vector-quantization",
      "cause": "The source independently quantizes glyph advances and positioning adjustments before summing them. Raw Aptos metrics retain finer precision in Chromium, putting the Week labels just below a pixel threshold.",
      "formula": "q(u) = 2 * floor(u / 2 + 0.5)",
      "units": "Original Aptos is 2048 units per em. Each hmtx advance, GPOS PairPos xAdvance, GPOS Format 1 mark-anchor coordinate and legacy kern pair value is prepared on the observed two-unit grid.",
      "example": {
        "text": "Week 1 - 3",
        "sourceNodeId": "1:2662",
        "rawAdvance14px": 61.9609375,
        "rawCeilPx": 62,
        "preparedAdvance14px": 62.001953125,
        "sourceHugPx": 63
      },
      "correction": "Generate deterministic prepared delivery copies at build time, retain all four approved original TTFs unchanged, and use normal browser shaping and kerning with those delivery faces.",
      "owner": "scripts/prepare-aptos-fonts.mjs",
      "internalScaleInference": "HarfBuzz scale 1024 for this 2048 UPM face implements the observed rule. Exact source vectors establish the quantization behavior; the queried Figma API does not expose its internal shaping scale/version.",
      "preparationProfile": {
        "version": 1,
        "figmaPrecision": 1024,
        "unitsPerEm": 2048,
        "rounding": "half-toward-positive-infinity"
      }
    }
  ],
