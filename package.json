{
  "name": "@snapp/ui-registry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync": "node scripts/sync-registry.mjs",
    "normalize": "node scripts/check-tailwind-canonical.mjs --fix",
    "normalize:check": "node scripts/check-tailwind-canonical.mjs",
    "registry:source:check": "node scripts/validate-registry-source.mjs",
    "registry:fonts:test": "node --test scripts/test-prepare-aptos-fonts.mjs",
    "registry:text:test": "node scripts/verify-hug-text-browser.mjs",
    "registry:keyboard:test": "node scripts/verify-tabs-keyboard-browser.mjs",
    "registry:figma:coverage": "node scripts/check-figma-coverage.mjs",
    "registry:figma:forms": "node scripts/verify-forms-browser.mjs",
    "registry:figma:form-geometry": "node scripts/verify-form-geometry-browser.mjs",
    "registry:figma:navigation": "node scripts/verify-navigation-browser.mjs",
    "registry:figma:work": "node scripts/verify-work-browser.mjs",
    "registry:canonical:check": "node scripts/check-tailwind-canonical.mjs",
    "registry:validate": "shadcn registry validate",
    "registry:build": "node scripts/clean-generated.mjs && shadcn build",
    "registry:integrity": "node scripts/verify-generated.mjs",
    "registry:smoke": "node scripts/smoke-install.mjs",
    "registry:verify": "npm run registry:fonts:test && npm run sync && npm run registry:validate && npm run registry:source:check && npm run registry:figma:coverage && npm run registry:canonical:check && npm run registry:build && npm run registry:integrity && npm run registry:smoke && npm run registry:integrity",
    "registry:serve": "vite --host 127.0.0.1 --port 4173"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/judson": "5.3.0",
    "@tailwindcss/oxide": "^4.3.3",
    "clsx": "^2.1.1",
    "playwright": "1.64.1",
    "shadcn": "4.12.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "8.1.0"
  }
}
